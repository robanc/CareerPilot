-- backend/tests/sql/04_test_demo_login_grants.sql
-- Stage B: isolated test database privileges.
-- REVIEW DRAFT ONLY - NOT APPROVED FOR EXECUTION.
--
-- Prerequisites:
-- 1. Mandatory external Docker isolation preflight.
-- 2. Script 03 has created and verified the disabled test role.
-- 3. Application tables are owned by careerpilot_test_admin.
--
-- PostgreSQL 16, careerpilot_test database only.

\set ON_ERROR_STOP on

BEGIN;

DO $$
BEGIN
    IF current_user IS DISTINCT FROM 'careerpilot_test_admin'
       OR current_database() IS DISTINCT FROM 'careerpilot_test'
       OR current_setting('cluster_name')
          IS DISTINCT FROM 'careerpilot-test'
       OR current_setting('hba_file')
          IS DISTINCT FROM '/etc/careerpilot/pg_hba.conf'
       OR NOT EXISTS (
           SELECT 1 FROM pg_roles
           WHERE rolname = current_user
             AND rolsuper
       )
    THEN
        RAISE EXCEPTION 'Refusing: unexpected test cluster identity';
    END IF;

    IF NOT EXISTS (
        SELECT 1
        FROM pg_authid
        WHERE rolname = 'careerpilot_test_demo_login'
        AND rolcanlogin
        AND rolpassword IS NULL
        AND rolvaliduntil IS NOT DISTINCT FROM
            '-infinity'::timestamptz
        AND NOT rolsuper
        AND NOT rolcreatedb
        AND NOT rolcreaterole
        AND NOT rolinherit
        AND NOT rolreplication
        AND NOT rolbypassrls
        AND rolconnlimit = 5
    ) THEN
        RAISE EXCEPTION 'Refusing: restricted test role missing or unsafe';
    END IF;

    IF EXISTS (
        SELECT 1
        FROM pg_auth_members
        WHERE member = (
            SELECT oid FROM pg_roles
            WHERE rolname = 'careerpilot_test_demo_login'
        )
        OR roleid = (
            SELECT oid FROM pg_roles
            WHERE rolname = 'careerpilot_test_demo_login'
        )
        OR grantor = (
            SELECT oid FROM pg_roles
            WHERE rolname = 'careerpilot_test_demo_login'
        )
    ) THEN
        RAISE EXCEPTION 'Refusing: unexpected test role membership';
    END IF;

IF EXISTS (
    SELECT 1
    FROM pg_db_role_setting
    WHERE setrole IN (
        0,
        (SELECT oid FROM pg_roles
         WHERE rolname = 'careerpilot_test_demo_login')
    )
    AND setdatabase IN (
        0,
        (SELECT oid FROM pg_database
         WHERE datname = 'careerpilot_test')
    )
) THEN
    RAISE EXCEPTION
        'Refusing: unexpected role/database settings';
END IF;

    IF (SELECT count(*) FROM pg_database) <> 4
    OR (
        SELECT count(*)
        FROM pg_database
        WHERE datname IN (
            'careerpilot_test',
            'postgres',
            'template0',
            'template1'
        )
    ) <> 4
    THEN
            RAISE EXCEPTION 'Refusing: unexpected database inventory';
        END IF;
END
$$;

-- Remove the ability to create temporary tables.
-- This changes PUBLIC privileges in the isolated test DB only.
REVOKE TEMPORARY
ON DATABASE careerpilot_test
FROM PUBLIC;

-- Permit access to application tables.
GRANT USAGE
ON SCHEMA public
TO careerpilot_test_demo_login;

GRANT SELECT
ON ALL TABLES IN SCHEMA public
TO careerpilot_test_demo_login;

-- Apply SELECT privileges to future tables created by
-- careerpilot_test_admin in the public schema.
ALTER DEFAULT PRIVILEGES
FOR ROLE careerpilot_test_admin
IN SCHEMA public
GRANT SELECT ON TABLES
TO careerpilot_test_demo_login;

-- PostgreSQL 16 function signatures verified via pg_proc.
-- Prevent PUBLIC execution of large-object creation functions.
REVOKE EXECUTE ON FUNCTION
    pg_catalog.lo_create(oid),
    pg_catalog.lo_creat(integer),
    pg_catalog.lo_from_bytea(oid, bytea)
FROM PUBLIC;

-- Verify the resulting privileges before committing.
-- psql must run with ON_ERROR_STOP enabled.
-- REVIEW SAFETY INTERLOCK: this dependency intentionally does not
-- resolve while files retain .sql.review extensions. Do not execute.
-- When approved, prepare separate .sql copies and validate their
-- exact contents and include path before execution.
\ir 05_test_demo_login_verify.sql

COMMIT;
